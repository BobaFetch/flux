@Component({
	selector: "app",
})
export abstract class Base<T extends object = {}> {
	protected abstract make(): T;

	run(input?: T): T | null {
		const value = input?.toString() ?? "none";
		if (!value) {
			return null;
		} else if (value.length > 3) {
			return this.make();
		}
		return input ?? null;
	}
}

