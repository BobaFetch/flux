int classify(int x, int y)
{
	int result = 0;

	if (x > 0)
		result = 1;
	else if (x < 0)
		result = -1;
	else
		result = 0;

	if (y)
	{
		result += 2;
	}
	else
	{
		result -= 2;
	}

	while (x > 0)
		x--;

	for (int i = 0; i < 10; i++) {
		if (i % 2)
			continue;
		result += i;
	}

	do {
		y++;
	} while (y < 10);

	do
		y--;
	while (y > 0);

	if (x)
		if (y)
			result = 3;
		else
			result = 4;

	return result;
}
