local M = {}

function M.setup(opts)
	opts = opts or {}
	if opts.enable then
		for i = 1, 10 do
			print(i)
		end
	elseif opts.other then
		while true do
			break
		end
	else
		repeat
			opts.n = opts.n - 1
		until opts.n == 0
	end
	return opts
end

