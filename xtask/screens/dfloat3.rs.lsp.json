{
 "capabilities": {
  "textDocumentSync": {
   "openClose": true,
   "change": 2
  },
  "positionEncoding": "utf-8"
 },
 "on": {
  "textDocument/didOpen": {
   "send": [
    {
     "method": "textDocument/publishDiagnostics",
     "params": {
      "uri": "$URI",
      "diagnostics": [
       {
        "range": {
         "start": {
          "line": 27,
          "character": 14
         },
         "end": {
          "line": 27,
          "character": 15
         }
        },
        "severity": 1,
        "message": "first problem on this line",
        "code": "E1"
       },
       {
        "range": {
         "start": {
          "line": 27,
          "character": 3
         },
         "end": {
          "line": 27,
          "character": 6
         }
        },
        "severity": 2,
        "message": "a second one\nthat spans two lines"
       },
       {
        "range": {
         "start": {
          "line": 2,
          "character": 11
         },
         "end": {
          "line": 2,
          "character": 14
         }
        },
        "severity": 3,
        "message": "a very long message a very long message a very long message a very long message a very long message a very long message "
       }
      ]
     }
    }
   ]
  }
 }
}