{
  "capabilities": { "textDocumentSync": { "openClose": true, "change": 2 }, "positionEncoding": "utf-16", "definitionProvider": true },
  "on": {
    "textDocument/definition": { "result": [
      { "targetUri": "$DIR/search.txt", "targetRange": { "start": { "line": 0, "character": 0 }, "end": { "line": 4, "character": 1 } },
        "targetSelectionRange": { "start": { "line": 2, "character": 5 }, "end": { "line": 2, "character": 10 } } }
    ] }
  }
}
